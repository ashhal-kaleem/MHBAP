# ── Application ──────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-in-production-use-32-random-chars
DEBUG=true

# ── Database ─────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://mhbap:mhbap@localhost:5432/mhbap
DATABASE_SYNC_URL=postgresql://mhbap:mhbap@localhost:5432/mhbap

# ── Redis ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── ML ────────────────────────────────────────────────
DEVICE=cpu                  # cpu | cuda | mps
MODEL_WEIGHTS_DIR=ml/models/weights
INFERENCE_FPS=1             # predictions per second
WINDOW_SECONDS=30           # temporal context window

# ── CORS ─────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
