# MHBAP — Windows .gitignore (For Windows User / Teammate)

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
.venv/
venv/
env/
*.egg-info/
dist/
build/
.eggs/
*.egg
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
coverage.xml
*.log

# Windows OS Specific Files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump
*.url

# Visual Studio / VS Code Windows Artifacts
*.suo
*.user
*.userosscache
*.sln.docstates
.vs/
.vscode/
.idea/
*.iml
*.iws
*.ipr

# Node / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
.next/
.nuxt/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ML / Data
ml/models/weights/*.pt
ml/models/weights/*.pth
ml/models/weights/*.onnx
ml/datasets/raw/
ml/datasets/processed/
data/sessions/
data/exports/
*.h5
*.hdf5
*.pkl
*.npy
*.npz

# Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12

# Docker
docker/postgres_data/
docker/redis_data/
docker/docker-compose.yml.bak

# Training logs and error outputs
scripts/training_log*.txt
scripts/training_err*.txt
scripts/distcheck.txt
scripts/run_training_v[0-9]*.py

# Temporary / debug root scripts
check_saved_weights.py
data_leakage_audit.py
patch_writer.py
test_emotion_quick.py

# Internal audit reports
AUDIT_REPORT.md

# Docs build
site/
docs/_build/
