FROM python:3.9-slim

WORKDIR /app

# System deps for OpenCV + audio
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential linux-libc-dev libgl1 libglib2.0-0 libsndfile1 ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
COPY backend/ ./backend/
COPY ml/ ./ml/
COPY scripts/ ./scripts/

RUN pip install --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cpu \
    "torch==2.3.1+cpu" "torchvision==0.18.1+cpu" -e ".[ml]"

EXPOSE 8000

CMD ["sh", "-c", "cd backend && alembic upgrade head && cd .. && uvicorn backend.app.main:app --host 0.0.0.0 --port 8000 --workers 2"]
